default_platform(:ios)

API_KEY_ID = "2B498P3H5Y"
API_ISSUER_ID = "69a6de84-85d3-47e3-e053-5b8c7c11a4d1"
API_KEY_PATH = File.expand_path("~/.appstoreconnect/private_keys/AuthKey_2B498P3H5Y.p8")

platform :ios do
  desc "Build, archive and upload to TestFlight"
  lane :deploy do
    api_key = app_store_connect_api_key(
      key_id: API_KEY_ID,
      issuer_id: API_ISSUER_ID,
      key_filepath: API_KEY_PATH,
      duration: 1200,
      in_house: false
    )

    get_certificates(
      api_key: api_key,
      platform: "ios"
    )

    get_provisioning_profile(
      api_key: api_key,
      app_identifier: "com.digifox.app",
      platform: "ios"
    )

    profile_name = lane_context[SharedValues::SIGH_NAME]

    build_app(
      project: "DigiFox.xcodeproj",
      scheme: "DigiFox",
      destination: "generic/platform=iOS",
      output_directory: "build/export",
      output_name: "DigiFox.ipa",
      archive_path: "build/DigiFox.xcarchive",
      export_method: "app-store",
      clean: true,
      silent: true,
      xcargs: "-allowProvisioningUpdates " \
              "CODE_SIGN_STYLE=Manual " \
              "PROVISIONING_PROFILE_SPECIFIER='com.digifox.app AppStore' " \
              "CODE_SIGN_IDENTITY='Apple Distribution'",
      export_options: {
        signingStyle: "manual",
        provisioningProfiles: {
          "com.digifox.app" => profile_name
        }
      }
    )

    upload_to_testflight(
      api_key: api_key,
      ipa: "build/export/DigiFox.ipa",
      skip_waiting_for_build_processing: true,
      skip_submission: true
    )
  end
end
